# Wartości domyślne do developmentu — ten plik JEST w repo.
# Nadpisuj lokalnie/produkcyjnie przez .env.local (ignorowany przez git).

# Porty deweloperskie trzymamy w puli 7200+ (API 7200, front 7201, baza 7202),
# żeby projekt nie kolidowal z innymi uruchomionymi lokalnie.

# --- Backend ---
NODE_ENV=development
PORT=7200

# Postgres (dev: lokalna instancja; prod: istniejący Postgres na serwerze)
DB_HOST=localhost
DB_PORT=7202
DB_NAME=cue
DB_USER=cue
DB_PASSWORD=cue
DB_SSL=false

# Admin: hasło wpisywane w /admin
ADMIN_PASSWORD=familiada
# Sekret do podpisywania JWT admina — w produkcji: openssl rand -hex 32
ADMIN_TOKEN_SECRET=dev-secret-nie-uzywaj-na-produkcji-0123456789abcdef

# Publiczny adres, z którego gracze skanują QR (lobby na TV)
PUBLIC_URL=http://localhost:7201

# --- Frontend (Vite, build-time) ---
# Puste = ten sam origin co strona (produkcja za Caddy)
VITE_API_URL=http://localhost:7200
